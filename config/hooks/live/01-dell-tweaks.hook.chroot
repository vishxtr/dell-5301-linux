#!/bin/sh
set -e

echo "=== Applying Dell Inspiron 5301 Customizations ==="

# 1. Enable 32-bit architecture for complete Windows App support (Wine32)
dpkg --add-architecture i386 || true
apt-get update || true
apt-get install -y --no-install-recommends wine32 libwine:i386 || true

# 2. Add Flathub Repository for 1-click Windows/Android helper apps (Bottles, etc.)
flatpak remote-add --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo || true

# 3. Add official Waydroid repository (Native Android app container for Linux)
mkdir -p /etc/apt/trusted.gpg.d /etc/apt/sources.list.d
curl -fsSL https://repo.waydroid.net/waydroid.gpg -o /etc/apt/trusted.gpg.d/waydroid.gpg || true
echo "deb [signed-by=/etc/apt/trusted.gpg.d/waydroid.gpg] https://repo.waydroid.net/ bookworm main" > /etc/apt/sources.list.d/waydroid.list
apt-get update || true
apt-get install -y waydroid || true

# 4. Configure Android USB udev rules (Plug & Play ADB/Scrcpy without permissions issues)
usermod -aG plugdev,dialout,video,audio user 2>/dev/null || true

# 5. Enable essential systemd services
systemctl enable thermald || true
systemctl enable power-profiles-daemon || true
systemctl enable zramswap || true
systemctl enable earlyoom || true
systemctl enable gdm3 || true
systemctl enable pipewire || true
systemctl enable wireplumber || true
systemctl enable waydroid-container || true

# 6. Set up dconf defaults for GNOME (Dark mode, Gestures, GSConnect)
mkdir -p /etc/dconf/profile
cat <<'EOF' > /etc/dconf/profile/user
user-db:user
system-db:local
EOF

mkdir -p /etc/dconf/db/local.d
cat <<'EOF' > /etc/dconf/db/local.d/01-dell-defaults
[org/gnome/desktop/interface]
color-scheme='prefer-dark'
gtk-theme='Adwaita-dark'
show-battery-percentage=true
font-name='Inter 10'
document-font-name='Inter 10'
monospace-font-name='JetBrains Mono 10'

[org/gnome/desktop/peripherals/touchpad]
tap-to-click=true
natural-scroll=true
two-finger-scrolling-enabled=true

[org/gnome/desktop/wm/preferences]
button-layout='appmenu:minimize,maximize,close'

[org/gnome/shell]
enabled-extensions=['gsconnect@andyholmes.github.io']
favorite-apps=['firefox-esr.desktop', 'org.gnome.Nautilus.desktop', 'scrcpy.desktop', 'org.gnome.Terminal.desktop']
EOF

# Update dconf database
dconf update || true

echo "=== All Dell & Android/Windows Customizations Applied Successfully ==="
